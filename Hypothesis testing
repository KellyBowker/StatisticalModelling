    "def linear_regression(x, y):\n",
    "    results = stats.linregress(x, y)\n",
    "    return results.slope, results.intercept\n",
    "\n",
    "a, b = linear_regression(x, y)\n",
    "\n",
    "res = stats.bootstrap(\n",
    "    (x, y),\n",
    "    linear_regression,\n",
    "    confidence_level=0.95,\n",
    "    paired=True,\n",
    "    n_resamples=10000,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "low = res.confidence_interval.low\n",
    "high = res.confidence_interval.high\n",
    "\n",
    "print(\"Slope:\", a)\n",
    "print(\"95% CI:\", [low[0], high[0]])\n",
    "\n",
    "print(\"Intercept:\", b)\n",
    "print(\"95% CI:\", [low[1], high[1]])\n",
    "\n",
    "print(\"p-value:\", p_value)"
   ]
  },
