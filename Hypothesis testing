   "metadata": {},
   "outputs": [],
   "source": [
    "# Define significance level\n",
    "alpha = 0.05\n",
    "\n",
    "# Perform linear regression\n",
    "results = stats.linregress(x, y)\n",
    "\n",
    "slope = results.slope\n",
    "intercept = results.intercept\n",
    "p_value = results.pvalue\n",
    "std_error = results.stderr\n",
    "r_value = results.rvalue\n",
    "\n",
    "# Calculate test statistic\n",
    "t_stat = slope / std_error\n",
    "\n",
    "print(\"Sample size:\", len(x))\n",
    "print(\"Slope:\", slope)\n",
    "print(\"Intercept:\", intercept)\n",
    "print(\"Standard error:\", std_error)\n",
    "print(\"t-statistic:\", t_stat)\n",
    "print(\"Degrees of freedom:\", len(x) - 2)\n",
    "print(\"p-value:\", p_value)\n",
    "print(\"Correlation coefficient:\", r_value)\n",
    "print(\"R-squared:\", r_value**2)\n",
    "\n",
    "# Hypothesis test conclusion\n",
    "if p_value < alpha:\n",
    "    print(\"Reject the null hypothesis.\")\n",
    "    print(\"There is a statistically significant linear relationship.\")\n",
    "else:\n",
    "    print(\"Fail to reject the null hypothesis.\")\n",
    "    print(\"There is insufficient evidence of a linear relationship.\")"
   ]
  },
  {
