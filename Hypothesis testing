   "source": [
    "# Select the relevant variables and remove missing values\n",
    "data = df[['total_sleep', 'max_life_span']].dropna()\n",
    "\n",
    "x = data['total_sleep'].to_numpy()\n",
    "y = data['max_life_span'].to_numpy()\n",
    "\n",
    "print(\"Sample size:\", len(x))"
   ]
  },
  {
   "cell_type": "code",
